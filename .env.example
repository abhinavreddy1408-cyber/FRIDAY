# F.R.I.D.A.Y. Configuration Template
# Copy this file to .env and fill in your credentials.

# ── NVIDIA / LLM ────────────────────────────────────────────────────────────
# Required: Get your key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# Optional per-role NVIDIA NIM keys. Leave blank to use NVIDIA_API_KEY.
FRIDAY_NIM_KEY_CODING_PRIMARY_CODER=
FRIDAY_NIM_KEY_CODING_SPECIALIST_CODER=
FRIDAY_NIM_KEY_CODING_CODE_REVIEWER=
FRIDAY_NIM_KEY_CODING_GENERAL_VERIFIER=
FRIDAY_NIM_KEY_REASONING_PRIMARY_REASONER=
FRIDAY_NIM_KEY_REASONING_LOGIC_VERIFIER=
FRIDAY_NIM_KEY_SEARCH_PRIMARY_SYNTHESIZER=
FRIDAY_NIM_KEY_BRAINSTORMING_PRIMARY_IDEATOR=
FRIDAY_NIM_KEY_DOCUMENT_PRIMARY_WRITER=
FRIDAY_NIM_KEY_FILE_ANALYSIS_PRIMARY_EXTRACTOR=
FRIDAY_NIM_KEY_SCREEN_INTERACTION_FAST_SCREENER=
FRIDAY_NIM_KEY_SAFETY_CONTENT_SAFETY=
FRIDAY_NIM_KEY_SAFETY_SAFETY_CLASSIFIER=

# ── ElevenLabs TTS (Optional) ────────────────────────────────────────────────
# High-quality voice. Falls back to pyttsx3 if not set.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
ELEVENLABS_MODEL=eleven_turbo_v2

# ── Speech Recognition ───────────────────────────────────────────────────────
# Providers: google | vosk
STT_PROVIDER=google
VOSK_MODEL_PATH=models/vosk-model
WAKE_WORD=friday
WAKE_WORD_SENSITIVITY=0.5

# ── Microphone / Audio ───────────────────────────────────────────────────────
MIC_ENERGY_THRESHOLD=300
MIC_PAUSE_THRESHOLD=0.8
MIC_PHRASE_LIMIT=15
NOISE_REDUCTION_ENABLED=True

# ── Speaker Verification ─────────────────────────────────────────────────────
SPEAKER_VERIFICATION_ENABLED=True
VOICE_PROFILE_PATH=data/voice_profile.npy
SPEAKER_THRESHOLD=0.75

# ── Memory & Storage ─────────────────────────────────────────────────────────
MEMORY_DB_PATH=data/memory.db
CHROMA_DB_PATH=data/chroma
GOALS_DB_PATH=data/goals.db
LEARNING_DB_PATH=data/learning.db
MAX_CONVERSATION_HISTORY=20

# ── Conversation / UX ────────────────────────────────────────────────────────
CONVERSATION_TIMEOUT=15
CONFIRM_DESTRUCTIVE_ACTIONS=True

# ── Proactive Monitoring ─────────────────────────────────────────────────────
MONITOR_CPU=True
CPU_ALERT_THRESHOLD=85.0
MONITOR_SCREEN=False
SCREEN_POLL_INTERVAL=60

# ── Gmail Integration (Optional) ──────────────────────────────────────────────
GMAIL_CREDENTIALS_PATH=credentials/gmail_credentials.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/friday.log

# ── Privacy ──────────────────────────────────────────────────────────────────
PRIVACY_MODE=False
